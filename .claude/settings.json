{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "uv run --no-project --quiet python \"$(git rev-parse --show-toplevel)/.claude/hooks/usage_statusline.py\""
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format)",
      "Bash(uv run ruff format *)",
      "Bash(uv run python tools/check_licenses.py)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "PowerShell(uv run pytest)",
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff check *)",
      "PowerShell(uv run ruff format *)",
      "PowerShell(git status)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(gh pr merge *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(py -m pip install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uv tool install *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X PATCH *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(py -m pip install *)",
      "PowerShell(uv add *)",
      "PowerShell(uv pip install *)",
      "PowerShell(git tag *)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow run *)"
    ],
    "deny": [
      "Edit(tests/corpus/**/expected/**)",
      "Edit(src/pagevoice/voice/model_manifest.json)",
      "Edit(tests/voice/sentences.tsv)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d*)",
      "Bash(git push * :*)",
      "Bash(git push * +*)",
      "Bash(gh pr merge *--delete-branch*)",
      "Bash(gh pr merge * -d*)",
      "Bash(gh api -X DELETE *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push * -d*)",
      "PowerShell(git push * :*)",
      "PowerShell(git push * +*)",
      "PowerShell(gh pr merge *--delete-branch*)",
      "PowerShell(gh pr merge * -d*)",
      "PowerShell(gh api -X DELETE *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking protected files"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_after_edit.py\"",
            "timeout": 60,
            "statusMessage": "ruff format + check"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests_before_stop.py\"",
            "timeout": 300,
            "statusMessage": "Running fast tests before finishing"
          }
        ]
      }
    ]
  }
}
